{
  "name": "cambia-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:remote": "vite --mode remote",
    "dev:remote-lite": "vite build --watch --mode development & vite preview --mode remote",
    "build": "tsc -b && vite build && node scripts/check-copy.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "check-tokens": "node scripts/check-theme-tokens.mjs",
    "check-copy": "node scripts/check-copy.mjs",
    "test:resend": "node --test scripts/test-resend-decision.mjs",
    "test:snap": "node --test scripts/test-snap-success.mjs",
    "test:snap-fill": "node --test scripts/test-snap-fill.mjs",
    "test:modal-focus": "node --test scripts/test-modal-focus.mjs",
    "test:names": "node --test scripts/test-card-names.mjs",
    "test:hand-layout": "node --test scripts/test-hand-layout.mjs",
    "test:circuit-copy": "node --test scripts/test-circuit-copy.mjs",
    "test:lock": "node --test scripts/test-hand-lock.mjs",
    "test:pregame-peek": "node --test scripts/test-pregame-peek.mjs",
    "test:preset": "node --test scripts/test-lobby-preset.mjs",
    "test:rule-buffer": "node --test scripts/test-lobby-rule-buffer.mjs",
    "test:round-counter": "node --test scripts/test-round-counter.mjs",
    "test:special-prompt": "node --test scripts/test-special-prompt.mjs",
    "test:game-store-events": "node --test scripts/test-game-store-events.mjs",
    "test:tab-session": "node --test scripts/test-tab-session.mjs",
    "test:dev-switcher": "node --test scripts/test-dev-switcher.mjs",
    "test:type-label": "node --test scripts/test-lobby-type-label.mjs",
    "test:rules-lock": "node --test scripts/test-lobby-rules-lock.mjs",
    "test:gpu-key": "node --test scripts/test-resource-gpu-key.mjs",
    "test:render": "vitest run",
    "test:unit": "node --test scripts/test-resend-decision.mjs scripts/test-snap-success.mjs scripts/test-snap-fill.mjs scripts/test-modal-focus.mjs scripts/test-card-names.mjs scripts/test-hand-layout.mjs scripts/test-circuit-copy.mjs scripts/test-hand-lock.mjs scripts/test-pregame-peek.mjs scripts/test-lobby-preset.mjs scripts/test-lobby-rule-buffer.mjs scripts/test-round-counter.mjs scripts/test-special-prompt.mjs scripts/test-game-store-events.mjs scripts/test-tab-session.mjs scripts/test-dev-switcher.mjs scripts/test-lobby-type-label.mjs scripts/test-lobby-rules-lock.mjs scripts/test-resource-gpu-key.mjs scripts/test-training-runs-key.mjs",
    "test": "npm run test:unit && npm run test:render",
    "measure-dev-transfer": "node scripts/measure-dev-transfer.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "axios": "^1.8.4",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.3",
    "immer": "^11.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.0",
    "uplot": "^1.6.32",
    "uplot-react": "^1.2.4",
    "uuid": "^11.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@stylistic/eslint-plugin-ts": "^4.2.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "@vitejs/plugin-react": "^4.3.4",
    "compression": "^1.8.1",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.11"
  }
}
