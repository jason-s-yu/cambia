[Unit]
Description=Cambia serving-harness runner daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cambia
WorkingDirectory=/srv/cambia
Environment=RUNNERD_BASE_DIR=/srv/cambia
Environment=RUNNERD_RUNS_DIR=/srv/cambia/runs
# Concurrency cap (cambia-655): 3 shared job slots for wall-clock throughput. A
# job spec's exclusive=true carve-out overrides this, running that job alone.
Environment=RUNNERD_MAX_CONCURRENT_JOBS=3
Environment=RUNNERD_MIN_FREE_RAM_GB=8
Environment=RUNNERD_MIN_FREE_DISK_GB=20
# Device capability gate (comma-separated: cpu, cuda, xpu). Uncomment and add
# a device only once this host actually has the matching GPU driver stack.
#Environment=RUNNERD_ALLOWED_DEVICES=cpu
Environment=RUNNERD_JWT_PUBKEY=/srv/cambia/keys/jwt_ed25519.pub
Environment=RUNNERD_TLS_CERT=/srv/cambia/keys/tls.crt
Environment=RUNNERD_TLS_KEY=/srv/cambia/keys/tls.key
# v1 has no browser consumer; this gates browser-originated WS only. The CLI
# client sends no Origin header and is admitted on Bearer auth.
Environment=RUNNERD_ALLOWED_ORIGIN=https://dashboard.example.invalid
ExecStart=/usr/local/bin/cambia-runnerd --listen 0.0.0.0:8090
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
# PrivateTmp is OFF for the same reason KillMode is `process`: jobs outlive the
# daemon incarnation that launched them. PrivateTmp binds every child into a
# per-incarnation mount namespace whose backing directory systemd deletes when
# that incarnation stops, so a surviving job would be left with a /tmp pointing
# at a deleted directory. The runner is a single-purpose unprivileged container,
# so the daemon and its jobs share the host /tmp instead.
PrivateTmp=no
# Job-preserving restart (cambia-655). SIGTERM detaches the daemon from its
# jobs: it exits without signalling them and the next incarnation re-adopts
# them at Reconcile, where a watcher finalizes each one when its process exits.
# KillMode=process is what makes that hold -- under mixed (or control-group)
# systemd SIGKILLs everything left in the service cgroup once the main process
# exits, which is every training job. A stop must never kill a training job;
# jobs are stopped only through the control-plane API.
KillMode=process
TimeoutStopSec=35

[Install]
WantedBy=multi-user.target
