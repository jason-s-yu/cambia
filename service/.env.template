CAMBIA_SERVICE_PORT=8080

POSTGRES_USER=cambia
POSTGRES_PASSWORD=cambia-1
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=cambia-dev

# Staging hosts on pangu. Caddy terminates TLS on :443 with per-host Let's
# Encrypt certs and reverse-proxies to the local dev processes:
#   https://app.cambia.pangu.home.jasonyu.io -> 172.17.0.1:5180  (vite dev server)
#   https://api.cambia.pangu.home.jasonyu.io -> 172.17.0.1:8088  (this service)
#   https://preview.cambia.pangu.home.jasonyu.io -> 172.17.0.1:3000  (compose nginx, optional)
# Browser work goes through the app host, which reaches this service through
# vite's same-origin proxy; the api host is for hitting REST or a WebSocket by
# hand. Neither needs a setting here: the service sends no CORS headers and
# does not read the Host header, and an unset ALLOWED_WS_ORIGINS accepts a WS
# upgrade from any origin. See web/README.md "Staging hosts on pangu".

# Dev identity switcher (cambia-1149). Set to 1 to register POST/GET
# /dev/session, which mints tab-scoped tokens for named dev accounts
# (<name>@dev.cambia.local, created on first use with a password nobody holds)
# and for fresh guests. Unset - the production default - leaves the routes
# unregistered, so /dev/session 404s like any unknown path. Accepting a token on
# Authorization: Bearer or a cambia-token.<jwt> WebSocket subprotocol entry is
# always on and needs no flag; only minting and the switcher UI are dev-only.
# The web client's ?as=<name> boot parameter needs this set.
# CAMBIA_DEV_ACCOUNTS=1

# Production hardening. All four are unset in dev, which keeps the dev behavior
# unchanged; the deploy/hawking stack sets them.
# COOKIE_SECURE=true            # add Secure + SameSite=Lax to auth_token
# ALLOWED_WS_ORIGINS=https://cambia.jasonyu.io  # comma-separated WS origin allowlist; unset means allow any origin
# RUN_MIGRATIONS=true           # apply un-applied migrations at boot; a failure is fatal
# TOKEN_EXPIRE_TIME=720h        # Go duration for session JWT lifetime ("never" or 0 for no expiry)
#
# COOKIE_SECURE against the pangu app host: the auth cookie is set on the app
# origin through vite's proxy, so Secure is fine there, and loopback tolerates
# it too (browsers treat http://localhost and http://127.0.0.1 as trustworthy
# origins and will store and replay a Secure cookie). A LAN IP or a tailnet
# name over plain http is not trustworthy: the cookie is dropped with no error
# and login appears to do nothing. Leave it unset unless the https host is the
# only lane in use.
